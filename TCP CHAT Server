#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

#define PORT 8400
#define SIZE 1024

int sfd, cfd;
struct sockaddr_in saddr, caddr;
socklen_t clen = sizeof(caddr);
char sbuf[SIZE], rbuf[SIZE];

int main() {
    sfd = socket(AF_INET, SOCK_STREAM, 0);
    if (sfd == -1) {
        perror("socket failed");
        exit(1);
    }

    saddr.sin_family = AF_INET;
    saddr.sin_port = htons(PORT);
    saddr.sin_addr.s_addr = INADDR_ANY;

    if (bind(sfd, (struct sockaddr*)&saddr, sizeof(saddr)) < 0) {
        perror("bind failed");
        close(sfd);
        exit(1);
    }

    if (listen(sfd, 1) < 0) {
        perror("listen failed");
        close(sfd);
        exit(1);
    }
    printf("Server listening on port %d...\n", PORT);

    cfd = accept(sfd, (struct sockaddr*)&caddr, &clen);
    if (cfd < 0) {
        perror("accept failed");
        close(sfd);
        exit(1);
    }
    printf("Client connected.\n");

    while (1) {
        int n = recv(cfd, rbuf, SIZE - 1, 0);
        if (n <= 0) {
            printf("Client disconnected.\n");
            break;
        }
        rbuf[n] = '\0';
        printf("Client: %s", rbuf);

        if (strncmp(rbuf, "bye", 3) == 0) break;

        printf("\nServer: ");
        fgets(sbuf, SIZE, stdin);
        send(cfd, sbuf, strlen(sbuf), 0);

        if (strncmp(sbuf, "bye", 3) == 0) break;
    }

    close(cfd);
    close(sfd);
    return 0;
}
