#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <netinet/in.h>

#define SIZE 100

int main(int argc, char *argv[])
{
    int sfd;
    struct sockaddr_in sadd;
    char sbuf[SIZE];
    char rbuf[SIZE];
    int n;
    if (argc != 3)
    {
        printf("ERROR:TWO ARGUEMENTS ARE NEEDED\n", argv[0]);
        exit(1);
    }
    sfd = socket(AF_INET, SOCK_STREAM, 0);
    if (sfd < 0)
    {
        perror("Socket failed");
        exit(1);
    }
    memset(&sadd, 0, sizeof(sadd));
    sadd.sin_family = AF_INET;
    sadd.sin_port = htons(atoi(argv[2]));
    if (inet_pton(AF_INET, argv[1], &sadd.sin_addr) <= 0)
    {
        perror("Invalid IP address");
        close(sfd);
        exit(1);
    }
    if (connect(sfd, (struct sockaddr *)&sadd, sizeof(sadd)) < 0)
    {
        perror("Connect failed");
        close(sfd);
        exit(1);
    }
    printf("Connected to server %s:%s\n", argv[1], argv[2]);
    printf("Type 'bye' to end the chat.\n\n");
    while (1)
    {
        printf("Client: ");
        scanf(" %[^\n]", sbuf);
        send(sfd, sbuf, strlen(sbuf), 0);
        if (strncmp(sbuf, "bye", 3) == 0)
        {
            break;
        }
        n = recv(sfd, rbuf, SIZE - 1, 0);
        if (n <= 0)
        {
            printf("Server disconnected\n");
            break;
        }
        rbuf[n] = '\0';
        printf("\nServer: %s\n", rbuf);
        if (strncmp(rbuf, "bye", 3) == 0)
        {
            break;
        }
    }
   close(sfd);
    return 0;
}
